# Init package template, in the layout Artix uses: its own PKGBUILD,
# separate from the main package. Copy it to packages/<initial>/<name>-openrc
# and adjust it (e.g. packages/f/foo-openrc, next to packages/f/foo).
# For runit, s6 and dinit the structure is the same; what changes are the
# installed files, the init dependency and the name (<name>-runit, <name>-s6,
# <name>-dinit).
#
# pkgver is the date of the script's last change (YYYYMMDD), not the
# program's version. Init packages have no .nvchecker.toml.

_pkgname=example
pkgname=$_pkgname-openrc
pkgver=20260101
pkgrel=1
pkgdesc="OpenRC init script for $_pkgname"
arch=(any)
url="https://github.com/arthurcelestinoe/Artix-Extra-Packages"
license=(0BSD)
depends=(openrc "$_pkgname")
# Only one init package per program can be installed.
provides=("init-$_pkgname")
conflicts=("init-$_pkgname")
source=("$_pkgname.initd"
        "$_pkgname.confd")
sha256sums=('SKIP'
            'SKIP')

package() {
  install -Dm755 "$_pkgname.initd" "$pkgdir/etc/init.d/$_pkgname"
  install -Dm644 "$_pkgname.confd" "$pkgdir/etc/conf.d/$_pkgname"
}
