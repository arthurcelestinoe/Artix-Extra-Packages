# Package template. Copy this directory to packages/<initial>/<name> and
# adjust it (e.g. packages/f/foo).
# Init scripts go in a separate package: see templates/package-openrc.

pkgname=example
pkgver=1.0.0
pkgrel=1
pkgdesc="Short description of the program"
arch=(x86_64)
url="https://github.com/OWNER/example"
license=(MIT)
depends=()
makedepends=()
# Source straight from upstream. The local name avoids clashes between packages.
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Filled in by updpkgsums (scripts/bump.sh runs it).
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  make
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
