pkgname=yay
pkgver=13.1.0
pkgrel=1
pkgdesc="Pacman wrapper and AUR helper written in Go"
arch=(x86_64)
url="https://github.com/Jguer/yay"
license=(GPL-3.0-or-later)
depends=(pacman git)
makedepends=('go>=2:1.26')
optdepends=('sudo: privilege elevation'
            'opendoas: privilege elevation')
# LTO does not mix with cgo's external linker.
options=(!lto)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('acd3c97fac52449ba3589fefc076b90f42fa5072ef274f5bcbcd381f50b2701a')

prepare() {
  cd "$pkgname-$pkgver"
  export GOPATH="$srcdir/gopath"
  # Download modules here, so build() does not need network access.
  go mod download -modcacherw
}

build() {
  cd "$pkgname-$pkgver"
  export GOPATH="$srcdir/gopath"
  export GOTOOLCHAIN=local
  export CGO_CPPFLAGS="$CPPFLAGS"
  export CGO_CFLAGS="$CFLAGS"
  export CGO_CXXFLAGS="$CXXFLAGS"
  export CGO_LDFLAGS="$LDFLAGS"
  # The Makefile already uses -trimpath -mod=readonly -modcacherw -buildmode=pie.
  make VERSION="$pkgver" PREFIX=/usr build
}

package() {
  cd "$pkgname-$pkgver"
  export GOPATH="$srcdir/gopath"
  export GOTOOLCHAIN=local
  make VERSION="$pkgver" PREFIX=/usr DESTDIR="$pkgdir" install
}
