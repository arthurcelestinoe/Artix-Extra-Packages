# Structure based on Arch Linux's telegram-desktop packaging (0BSD).
# AyuGram-specific build details (dependencies, tde2e commit, CMake options)
# follow the AUR ayugram-desktop package by ZhangHua.
#
# Built against the Artix system libraries, instead of the CentOS container
# upstream recommends for its official Linux builds.

pkgname=ayugram-desktop
pkgver=7.2.9
pkgrel=1
# tdlib commit for the tde2e library. Upstream's prepare.py pins 51743df
# (May 2025); the AUR package moved to this newer commit, which builds against
# current libraries such as OpenSSL 4. Recheck on every version bump.
_td_commit=bc9c263e2bfee06aaab41e82db51a103376030bc
pkgdesc="Desktop Telegram client with good customization and Ghost mode"
arch=(x86_64)
url="https://github.com/AyuGram/AyuGramDesktop"
license=('GPL-3.0-or-later WITH OpenSSL-exception')
depends=(abseil-cpp
         ada
         cmark-gfm
         ffmpeg
         glib2
         glibc
         hicolor-icon-theme
         hunspell
         kcoreaddons
         libavif
         libfido2
         libgcc
         libheif
         libjpeg-turbo
         libjxl
         libpipewire
         libsrtp
         libstdc++
         libvpx
         libxcb
         libxcomposite
         libxdamage
         libxext
         libxfixes
         libxkbcommon
         libxrandr
         libxtst
         lz4
         minizip
         openal
         openh264
         openssl
         opus
         pipewire
         qt6-base
         qt6-declarative
         qt6-imageformats
         qt6-svg
         qt6-wayland
         rnnoise
         tlottie
         xxhash
         zlib)
makedepends=(boost
             boost-libs
             cmake
             glib2-devel
             gobject-introspection
             gperf
             libtg_owt
             microsoft-gsl
             ninja
             python
             qt6-shadertools
             range-v3
             tl-expected
             vulkan-headers)
optdepends=('crow-translate: translation provider'
            'geoclue: geoinformation support'
            'webkit2gtk-4.1: embedded browser features provided by webkit2gtk-4.1 (gtk3)'
            'webkitgtk-6.0: embedded browser features provided by webkitgtk-6.0 (gtk4)'
            'xdg-desktop-portal: desktop integration')
# The LTO link of the whole client runs out of memory on GitHub's runners
# (16 GB) and gets killed in lto1.
options=(!lto)
source=("$pkgname-$pkgver-full.tar.gz::$url/releases/download/v$pkgver/AyuGramDesktop-$pkgver-full.tar.gz"
        "td-$_td_commit.tar.gz::https://github.com/tdlib/td/archive/$_td_commit.tar.gz")
sha256sums=('ead2665a32f38277e76d3041a5b780100afa0d87b7b1440c1278c5229936a842'
            'b4eb7ed255cbdce826211c9b8f84b05982dce0f02879b833e50020c3bff49576')

build() {
	# tde2e (end-to-end encryption for calls), installed into $srcdir only.
	cmake -S "td-$_td_commit" -B td-build \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX="$srcdir/td-install" \
		-DTD_E2E_ONLY=ON \
		-Wno-dev
	cmake --build td-build
	cmake --install td-build

	# API credentials from upstream's own build instructions
	# (docs/building-linux.md).
	cmake -S "AyuGramDesktop-$pkgver-full" -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=None \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-Dtde2e_DIR="$srcdir/td-install/lib/cmake/tde2e" \
		-DTDESKTOP_API_ID=2040 \
		-DTDESKTOP_API_HASH=b18441a1ff607e10a989891a5462e627 \
		-DDESKTOP_APP_DISABLE_AUTOUPDATE=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
